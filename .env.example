# Required: generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Database (default path works inside Docker with the volume mount)
DATABASE_URL=sqlite:////app/data/papersync.db

# Logging
LOG_LEVEL=INFO

# Application environment (production / development)
APP_ENV=production

# Web UI credentials
APP_USERNAME=admin
APP_PASSWORD=changeme

# Registry settings for docker-compose.yml
REGISTRY=registry.example.com
REGISTRY_OWNER=furchservices
TAG=latest
