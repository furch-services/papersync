# Required: generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Database (default path works inside Docker with the volume mount)
DATABASE_URL=sqlite:////app/data/papersync.db

# Logging
LOG_LEVEL=INFO

# Application environment (production / development)
APP_ENV=production

# Web UI credentials
APP_USERNAME=admin
APP_PASSWORD=changeme

# Webhook trigger (optional)
# Set a secret to enable POST /sync/trigger for external automation tools
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
